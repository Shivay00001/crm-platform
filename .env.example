# CRM Platform — environment template
# Copy to .env and fill in real values. Never commit a real .env to git.
# Dummy/placeholder values only in this file.

# Port the API listens on (Render sets this automatically).
PORT=8004

# Shared API secret. Every non-public endpoint (/contacts/*, /stats) requires
# it in the `x-api-key` request header. / and /health are public.
# Production refuses to boot without this set; locally the demo key is used
# if it is missing. Generate a real one, e.g. `openssl rand -hex 32`.
API_KEY=dev-demo-key-change-me

# Comma-separated list of frontend origins allowed by CORS.
# Empty = no browser cross-origin access (safest default; the API is not
# wide-open). Example for local dev:
# CORS_ORIGINS=http://localhost:3000,https://app.example.com
CORS_ORIGINS=

# Seed two demo contacts on boot. Set to "false" in production.
SEED_DEMO=true

# Environment name: development | test | production.
# NODE_ENV=production requires API_KEY to be set.
NODE_ENV=development

# ---- Production roadmap (not used by the demo API yet) ----
# PostgreSQL connection string (Supabase/Neon/local Postgres).
# DATABASE_URL=postgresql://user:pass@host:5432/crm
# Redis connection string (caching/queues).
# REDIS_URL=redis://localhost:6379
# JWT signing secret for user sessions (if you add login later).
# JWT_SECRET=change-me-to-a-long-random-string
